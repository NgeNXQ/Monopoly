  viewTilePayment: {fileID: 8188167172814421194}
  viewTileProposal: {fileID: 2112542374}
  viewTileManagement: {fileID: 2139109459493191900}
  viewCardPayment: {fileID: 7858969714857141373}
  viewCardInformation: {fileID: 3610361908087497333}
  viewTradeSender: {fileID: 4648731046598182364}
  viewTradeReceiver: {fileID: 2130441573}
  panelPlayersContainer: {fileID: 164058091}
  messageWon: "\u0412\u0456\u0442\u0430\u0454\u043C\u043E \u043F\u0435\u0440\u0435\u043C\u043E\u0436\u0446\u044F:"
  messageBankrupt: "\u0412\u0441\u0456\u0445 \u0432\u0430\u0448\u0438\u0445 \u0441\u0442\u0430\u0442\u043A\u0456\u0432
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E, \u0449\u043E\u0431
    \u0441\u043F\u043B\u0430\u0442\u0438\u0442\u0438 \u0431\u043E\u0440\u0433. \u0412\u0430\u0448
    \u0424\u041E\u041F \u0431\u0443\u0434\u0435 \u043B\u0456\u043A\u0434\u0432\u0456\u0434\u043E\u0432\u0430\u043D\u043E,
    \u0439 \u043E\u0447\u0456\u043A\u0443\u0439\u0442\u0435 \u043F\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443
    \u0437 \u0421\u0411\u0423."
  messageSentJail: "\u0412\u0438 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u043B\u044F\u0454\u0442\u0435\u0441\u044F
    \u0434\u043E \u0432'\u044F\u0437\u043D\u0438\u0446\u0456!"
  messageAlreadyBuilt: "\u0412\u0438 \u0432\u0436\u0435 \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u043B\u0438
    \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u0456 \u0437\u0430 \u0446\u0435\u0439
    \u0445\u0456\u0434!"
  messageDisconnecting: "\u0417\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
    \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E \u043C\u0435\u043D\u044E..."
  messageTradeAccepted: "\u041F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044E
    \u043E\u0431\u043C\u0456\u043D\u0443 \u0431\u0443\u043B\u043E \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043E!"
  messageTradeDeclined: "\u041F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u044E
    \u043E\u0431\u043C\u0456\u043D\u0443 \u0431\u0443\u043B\u043E \u0432\u0456\u0434\u0445\u0438\u043B\u0435\u043D\u043E!"
  messageHostDisconnected: "\u0425\u043E\u0441\u0442 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0432\u0441\u044F!"
  messageConfirmSurrender: "\u0414\u0456\u0439\u0441\u043D\u043E \u0431\u0430\u0436\u0430\u0454\u0442\u0435
    \u0437\u0434\u0430\u0442\u0438\u0441\u044F?"
  messageInsufficientFunds: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
    \u043A\u043E\u0448\u0442\u0456\u0432 \u0434\u043B\u044F \u0437\u0434\u0456\u0439\u0441\u043D\u0435\u043D\u043D\u044F
    \u043E\u043F\u0435\u0440\u0430\u0446\u0456\u0457!"
  messageLimitedTradesCount: "\u0412\u0438 \u0432\u0436\u0435 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0438
    \u0432\u0430\u0448\u0435 \u043F\u0440\u0430\u0432\u043E \u043E\u0431\u043C\u0456\u043D\u0443
    \u0437\u0430 \u0446\u0435\u0439 \u0445\u0456\u0434!"
  messageWaitingOtherPlayers: "\u041E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043D\u044F
    \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u0456\u043D\u0448\u0438\u0445
    \u0433\u0440\u0430\u0432\u0446\u0456\u0432..."
  messagePlayersFailedToLoad: "\u041D\u0435 \u0432\u0441\u0456\u043C \u0433\u0440\u0430\u0432\u0446\u044F
    \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0438\u0442\u0438\u0441\u044F.
    \u041F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F \u0434\u043E \u043B\u043E\u0431\u0431\u0456!"
  messageCannotUpgradeMaxLevel: "\u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
    \u043A\u0443\u043F\u0438\u0442\u0438, \u0434\u043E\u0441\u044F\u0433\u043D\u0443\u0442\u043E
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0438\u0439 \u0440\u0456\u0432\u0435\u043D\u044C!"
  messageWrongTradeCredentials: "\u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0456
    \u0443\u043C\u043E\u0432\u0438 \u043E\u0431\u043C\u0456\u043D\u0443!"
  messageCannotDowngradeMinLevel: "\u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
    \u043F\u0440\u043E\u0434\u0430\u0442\u0438, \u0432\u043B\u0430\u0441\u043D\u0456\u0441\u0442\u044C
    \u0443\u0436\u0435 \u0437\u0430\u043A\u043B\u0430\u0434\u0435\u043D\u0430!"
  messageOnlyEvenBuildingAllowed: "\u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E
    \u043F\u043E\u043A\u0440\u0430\u0449\u0438\u0442\u0438 \u0456\u043D\u0448\u0435
    \u043C\u0430\u0439\u043D\u043E \u0437 \u0446\u0456\u0454\u0457 \u043C\u043E\u043D\u043E\u043F\u043E\u043B\u0456\u0457!"
  messageCannotUpgradeNotProperty: "\u041C\u043E\u0436\u043D\u0430 \u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438
    \u043B\u0438\u0448\u0435 \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0456 \u043C\u043E\u043D\u043E\u043F\u043E\u043B\u0456\u0457!"
  messageCompleteMonopolyRequired: "\u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
    \u043A\u0443\u043F\u0438\u0442\u0438! \u041D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0430
    \u0437\u0456\u0431\u0440\u0430\u043D\u0430 \u043C\u043E\u043D\u043E\u043F\u043E\u043B\u0456\u044F!"
