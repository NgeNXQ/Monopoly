  buttonBackTabUnrankedLobbyConnection: {fileID: 2078587352}
  buttonConnectTabUnrankedLobbyConnection: {fileID: 13076518}
  textBoxCodeTabUnrankedLobbyConnection: {fileID: 691460116}
  nicknameMinLength: 1
  nicknameMaxLength: 10
  messageConfirmClosingGame: "\u0421\u043F\u0440\u0430\u0432\u0434\u0456 \u0431\u0430\u0436\u0430\u0454\u0442\u0435
    \u0432\u0438\u0439\u0442\u0438?"
  messageEstablishingConnection: "\u041F\u0456\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044F
    \u0434\u043E \u0456\u0433\u0440\u043E\u0432\u043E\u0457 \u043A\u0456\u043C\u043D\u0430\u0442\u0438..."
  messageEmptyJoinCode: "\u0412\u0432\u0435\u0434\u0456\u0442\u044C \u043A\u043E\u0434
    \u0456\u0433\u0440\u043E\u0432\u043E\u0457 \u0441\u0435\u0441\u0456\u0457!"
  messageInvalidLengthJoinCode: "\u041D\u0435\u0434\u0456\u0439\u0441\u043D\u0438\u0439
    \u043A\u043E\u0434 \u0456\u0433\u0440\u043E\u0432\u043E\u0457 \u0441\u0435\u0441\u0456\u0457!"
  messageNicknameEmpty: "\u0412\u0432\u0435\u0434\u0456\u0442\u044C \u043D\u0456\u043A\u043D\u0435\u0439\u043C!"
  messageNicknameTooLong: "\u041D\u0456\u043A\u043D\u0435\u0439\u043C \u0437\u0430\u043D\u0430\u0434\u0442\u043E
    \u0434\u043E\u0432\u0433\u0438\u0439!"
  messageNicknameTooShort: "\u041D\u0456\u043A\u043D\u0435\u0439\u043C \u0437\u0430\u043D\u0430\u0434\u0442\u043E
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439!"
  messageEnterCorrectNickname: "\u0412\u0432\u0435\u0434\u0456\u0442\u044C \u043A\u043E\u0440\u0435\u043A\u0442\u043D\u0438\u0439
    \u043D\u0456\u043A\u043D\u0435\u0439\u043C!"
  messageKicked: "\u0412\u0430\u0441 \u0431\u0443\u043B\u043E \u0432\u0438\u0433\u043D\u0430\u043D\u043E
    \u0437 \u043B\u043E\u0431\u0456!"
  messageLobbyIsFull: "\u041B\u043E\u0431\u0456 \u0432\u0436\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0435\u043D\u0435!"
  messageDisconnecting: "\u0412\u0456\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044F
    \u0432\u0456\u0434 \u0456\u0433\u0440\u043E\u0432\u043E\u0457 \u043A\u0456\u043C\u043D\u0430\u0442\u0438..."
  messageInvalidJoinCode: "\u041D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0438\u0439
    \u043A\u043E\u0434 \u0456\u0433\u0440\u043E\u0432\u043E\u0457 \u0441\u0435\u0441\u0456\u0457!"
  messageHostDisconnected: "\u0425\u043E\u0441\u0442 \u0432\u0456\u0434\u043A\u043B\u044E\u0447\u0438\u0432\u0441\u044F!"
  messageFailedToJoinLobby: "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
    \u043F\u0456\u0434'\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F \u0434\u043E
    \u043B\u043E\u0431\u0456!"
  messageGameCoordinatorIsDown: "\u0406\u0433\u0440\u043E\u0432\u0438\u0439 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u043E\u0440
    \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439!"
